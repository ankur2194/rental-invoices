# Public HTTPS URL served by your existing reverse proxy (no trailing path).
APP_URL=https://rent.example.com
# Host-side port and bind address. Keep loopback when nginx runs on this host.
HOST_PORT=3080
BIND_ADDRESS=127.0.0.1
# Internal application port; usually leave unchanged.
PORT=3000
NODE_ENV=production
COOKIE_SECURE=true
DB_PATH=/app/data/rental.sqlite
# Set to your nginx IP/CIDR only if you need forwarded client IPs for rate limiting.
# Never set to true for an application directly exposed to the internet.
TRUST_PROXY=
# Used only when the database is empty. Choose your own email and 12+ character password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional SMTP. Leave HOST and FROM empty to disable email entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional font overrides inside the container. DejaVu is installed by default.
# PDF_FONT_REGULAR=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
